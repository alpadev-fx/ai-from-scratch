---
export const prerender = false;
import { getUser, apiTry } from '../lib/session';
import { publicPrefs } from '../lib/prefs';
import { t, resolveLang } from '../lib/i18n';
import { grafo, org, curso } from '../lib/seo';
import { mercadoDe } from '../lib/region';
import { narrativaDe } from '../lib/narrative';
import { SITE, MARCA } from '../lib/site';
import { MONEDA, PRECIO_MENOR, PRECIO_TEXTO } from '../lib/price';
import { TOKENS, PUBLIC_BASE } from '../lib/theme-css';
import { icon } from '../lib/icons';
import PrefToggles from '../components/PrefToggles.astro';
import { jsonSafe } from '../lib/json-safe';
import MetaPixel from '../components/MetaPixel.astro';

const user = await getUser(Astro.request);

// Con sesión manda la preferencia de la cuenta; sin sesión, la cookie del dispositivo.
const dev = publicPrefs(Astro.request);
const langPref = user ? user.lang : dev.langPref;
const theme = user ? user.theme : dev.theme;
const lang = user ? resolveLang(user.lang, Astro.request) : dev.lang;
const L = t(lang);
const P = L.pub.pay;
// El precio sale de price.ts, no de un literal por pantalla: esta pagina lo
// pintaba tres veces a mano y el cupon lo formateaba una cuarta. El «antes»
// tachado ya no existe (ver price.ts): nunca se cobro y era un ancla falsa.
const precio = `${PRECIO_TEXTO[lang] ?? PRECIO_TEXTO.es} ${MONEDA}`;
const canonical = new URL(Astro.url.pathname, SITE).href;
// Narrativa según de dónde se conecta: en Colombia hay PSE y efectivo, en la UE
// manda el retracto de 14 días, y prometer un medio que no existe es peor que callar.
const { mercado, pais } = mercadoDe(Astro.request);
const N = narrativaDe(mercado, lang);
const jsonld = grafo(org(), curso(lang));
// Si el servicio de cobros no contesta, no hay con que cobrar. Antes la pagina
// pintaba los metodos, el cupon y «Suscribirme» igual, y el usuario solo se
// enteraba tras rellenarlo todo y pulsar: un 503 convertido en «hubo un error».
// Un boton que no puede cobrar no se dibuja.
const cobros = await apiTry<{ disponible: boolean; publicKey: string | null }>('/api/payments/estado', Astro.request);
const hayCobro = cobros.data?.disponible === true;
// La clave PUBLICA de Mercado Pago, para montar el Payment Brick al cargar en
// vez de tener que crear una preferencia solo para averiguarla. Es publica: no
// autoriza ningun cobro, solo tokeniza una tarjeta contra esta cuenta.
const mpKey = cobros.data?.publicKey ?? '';
---
<!doctype html>
<html lang={lang} data-theme={theme}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <MetaPixel />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <title>{P.eb} · IA desde cero</title>
  <link rel="canonical" href={canonical}>
  <meta property="og:site_name" content={MARCA}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <script type="application/ld+json" is:inline set:html={jsonld}></script>
  <style is:global set:html={TOKENS + PUBLIC_BASE}></style>
  <style is:global>
    /* Aviso de cuenta. Vive aqui y no en un layout porque /pago no usa
       layouts/App.astro: duplicar estas seis reglas cuesta menos que arrastrar
       una hoja entera de estilos de la app dentro de una pagina publica. */
    .up-back{position:fixed;inset:0;z-index:60;display:none;align-items:center;justify-content:center;
      padding:20px;background:rgba(0,0,0,.62)}
    .up-back[data-on]{display:flex}
    .up-card{background:var(--bg);border:1px solid var(--hair);max-width:460px;width:100%;
      padding:24px;display:flex;flex-direction:column;gap:12px}
    .up-row{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:6px}
    .up-cta{background:var(--fg);color:var(--bg);padding:11px 18px;text-decoration:none;
      font-size:13px;letter-spacing:.04em;text-transform:uppercase}
    .up-no{background:none;border:1px solid var(--hair);color:var(--l2);padding:11px 16px;
      font-size:13px;cursor:pointer;text-decoration:none;display:inline-block}
    .h1{font-size:38px}
    .btn.pay{height:52px;width:100%}
    .row{display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--hair2)}
    .coupon{display:flex;gap:8px;margin-top:14px}.coupon input{flex:1;min-width:0;background:transparent;border:1px solid var(--hair);padding:12px;color:var(--l1);font:500 13px/1 var(--m)}
    .coupon button{background:var(--l1);color:var(--bg);border:0;padding:0 14px;font:600 11px/1 var(--m);cursor:pointer}.coupon button:focus-visible,.coupon input:focus-visible{outline:2px solid var(--ac);outline-offset:2px}
    /* `hidden` must win over `.coupon{display:flex}` and the consent row's flex: the
       author rule beats the UA [hidden] rule, so without this the coupon box and the
       consent checkbox stayed visible with the switch off (measured in the smoke test). */
    [hidden]{display:none!important}
    .consent{display:flex;gap:10px;align-items:flex-start;border-top:1px solid var(--hair2);padding-top:10px;cursor:pointer}
    @media(max-width:900px){.coupon{flex-wrap:wrap}.coupon input{min-width:100%;min-height:44px;font-size:16px}.coupon button{min-height:44px;width:100%}}
  </style>
</head>
<body>
  <header class="pay-head">
    <a href="/" style="display:flex;align-items:center;gap:11px;color:var(--l1)">
      <span class="mark">IA</span>
      <span style="font:600 13px/1.2 var(--f)">IA desde cero</span>
      <span class="lbl" style="margin-left:8px">{P.seguro}</span>
    </a>
    <div style="display:flex;align-items:center;gap:20px">
      <div class="pay-note" style="display:flex;align-items:center;gap:10px"><Fragment set:html={icon('lock', 16, 'var(--ok)')} /><span class="s">{P.noSales}</span></div>
      <PrefToggles lang={langPref} theme={theme} sync={!!user} labels={{ auto: L.pub.auto, dark: L.pub.oscuro, paper: L.pub.papel, langAria: L.pub.ariaIdioma, themeAria: L.pub.ariaTema }} />
    </div>
  </header>

  <div class="pay-grid">
    <section class="pay-copy" style="padding:44px 48px;display:flex;flex-direction:column;gap:26px;border-right:1px solid var(--hair2)">
      <div style="display:flex;flex-direction:column;gap:12px">
        <p class="eb">{P.eb}</p>
        <h1 class="h1">{P.h1}</h1>
        <p class="p" style="max-width:460px">{P.pitch}</p>
        <p class="eb" style="margin-top:4px">{N.eyebrow}</p>
        <div style="display:flex;flex-direction:column;gap:7px;margin-top:2px">
          {N.prueba.map((x) => (
            <div style="display:flex;gap:9px;align-items:flex-start">
              <Fragment set:html={icon('check', 14, 'var(--ok)')} />
              <span class="s" style="color:var(--l2)">{x}</span>
            </div>
          ))}
        </div>
      </div>
      <div style="display:flex;flex-direction:column;border-top:1px solid var(--hair);padding-top:18px">
        <div class="row"><span class="s" style="color:var(--l2)">{P.curso}</span><span class="num" style="font:500 15px/1 var(--m)">{precio}</span></div>
        <div class="row"><span class="s" style="color:var(--l2)">{P.renovacionRow}</span><span class="s" id="renew-row">{P.renovacionOff}</span></div>
        <div class="row"><span class="s" style="color:var(--l2)">{P.comision}</span><span class="s">{P.comisionV}</span></div>
        <div style="display:flex;justify-content:space-between;align-items:baseline;padding:16px 0 0"><span class="lbl">{P.totalHoy}</span><span class="num" style="font:700 30px/1 var(--f);letter-spacing:-.035em">{precio}</span></div>
      </div>
      <div class="card" style="display:flex;gap:12px;align-items:flex-start;border-left:2px solid var(--ok)">
        <Fragment set:html={icon('check', 18, 'var(--ok)')} />
        <div><div class="h3">{N.garantiaTit}</div><p class="s" style="color:var(--l2);margin-top:4px">{N.garantiaTxt}</p></div>
      </div>
      <div style="margin-top:auto;border-top:1px solid var(--hair2);padding-top:18px">
        <p class="lbl">{N.pagoTit}</p>
        <p class="s" style="color:var(--l2);max-width:460px;margin-top:8px">{N.pagoTxt}</p>
        <p class="s" style="color:var(--l2);max-width:460px;margin-top:8px">{P.comoCobraB}</p>
        <div style="display:flex;flex-wrap:wrap;gap:7px;margin-top:12px">
          {N.medios.map((m) => (
            <span class="lbl" style="border:1px solid var(--hair2);padding:6px 9px;color:var(--l2)">{m}</span>
          ))}
        </div>
      </div>
    </section>

    <section class="pay-box" style="padding:44px 40px;background:var(--panel);display:flex;flex-direction:column;gap:20px">
      <div style="display:flex;align-items:center;justify-content:space-between">
        <p class="lbl">{P.metodo}</p>
        {hayCobro && <span class="lbl" style="color:var(--ac)">MERCADO PAGO</span>}
      </div>

      {hayCobro && !user && (
        <div class="card" data-tut="pago-1" style="border-color:var(--or);display:flex;gap:12px;align-items:flex-start">
          <Fragment set:html={icon('alert', 18, 'var(--or)')} />
          <div><div class="h3">{P.cuentaPrimero}</div><p class="s" style="color:var(--l2);margin-top:4px"><a href="/registro">{P.registrarme}</a> — {P.cuentaPrimeroB}</p></div>
        </div>
      )}

      {hayCobro ? (
      <Fragment>
      <div data-tut="pago-2" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px">
        <button class="chip" data-m="card" data-on>{P.tarjeta}</button>
        {mercado !== 'us' && mercado !== 'eu' && <button class="chip" data-m="wallet">{P.wallet}</button>}
        {mercado === 'co' && <button class="chip" data-m="pse">{P.pse}</button>}
        {mercado === 'co' && <button class="chip" data-m="cash">{P.efectivo}</button>}
      </div>

      <!-- El estado inicial de esta caja NO puede ser siempre "cargando": montarBrick()
           sale temprano cuando falta la sesion o la llave publica (ver el guard de
           `!mpKey || !logged`), y entonces nadie vuelve a tocar este nodo. Dejar el
           texto de carga ahi convierte una condicion conocida en un spinner eterno:
           el aviso de arriba dice "crea tu cuenta" mientras esta caja promete un
           formulario que jamas va a llegar. Se decide en el servidor, que ya sabe
           las dos cosas. -->
      <div id="brick" style="border:1px solid var(--hair);padding:20px;min-height:220px;display:flex;flex-direction:column;gap:12px">
        <span class="lbl">{P.datos}</span>
        {!user
          ? <p class="s" style="color:var(--l2)">{P.sinCuentaB} <a href="/registro">{P.registrarme}</a></p>
          : mpKey
            ? <p class="s" style="color:var(--l2)">{P.brickCarga}</p>
            : <p class="s" style="color:var(--l2)">{P.brickNoCarga}</p>}
      </div>

      <div id="pse-note" hidden class="card" style="border-color:var(--or)">
        <p class="s" style="color:var(--l2)">{P.pseNota}</p>
      </div>

      <!-- Renovacion automatica: OPCIONAL y apagada por defecto. Encendida manda
           mode=subscription (preapproval de Mercado Pago, cobro mensual hasta
           cancelar desde /perfil); apagada, un pago de 30 dias. El consentimiento
           se muestra solo cuando esta encendida: es una autorizacion de cobro
           recurrente, no letra pequena. -->
      <div class="card" id="renew" style="display:flex;flex-direction:column;gap:10px">
        <label for="auto-renew" style="display:flex;align-items:center;justify-content:space-between;gap:14px;cursor:pointer">
          <span class="h3">{P.renovar}</span>
          <input id="auto-renew" type="checkbox" role="switch" autocomplete="off" style="width:44px;height:24px;margin:0;accent-color:var(--ac);cursor:pointer">
        </label>
        <p class="s" id="renew-help" style="color:var(--l2)">{P.renovarOff}</p>
        <p class="s" id="renew-card" hidden style="color:var(--or)">{P.renovarTarjeta}</p>
        <!-- Consentimiento expreso y SEPARADO del interruptor: encender la renovacion
             dice que la quieres; esta casilla autoriza el cobro recurrente. Sin ella
             el boton no cobra. Estatuto del Consumidor (Ley 1480): consentimiento
             expreso, cancelacion por el mismo canal, sin trabas. -->
        <label id="renew-consent" class="consent" hidden for="consent">
          <input id="consent" type="checkbox" autocomplete="off" style="margin:3px 0 0;accent-color:var(--ac);flex:none">
          <span class="s">{P.consent}</span>
        </label>
      </div>

      <div class="coupon" id="coupon-box">
        <input id="coupon" type="text" maxlength="64" autocomplete="off" placeholder={P.cuponPh} aria-label={P.cuponLbl}>
        <button id="apply-coupon" type="button">{P.aplicarCupon}</button>
      </div>
      <p class="s" id="coupon-note" hidden style="color:var(--l2)">{P.cuponSub}</p>
      <div id="coupon-status" class="s" role="status" aria-live="polite"></div>

      <label class="consent" for="terms" style="display:flex;gap:10px;align-items:flex-start;margin-top:8px">
        <input id="terms" type="checkbox" autocomplete="off" style="margin:3px 0 0;accent-color:var(--ac);flex:none">
        <span class="s">{P.terminosA}<a href="/terminos">{P.terminosL}</a>{P.terminosB}</span>
      </label>
      <button class="btn pay" id="pay" data-tut="pago-3" style="margin-top:auto">{P.pagarUna}</button>
      </Fragment>
      ) : (
      <div class="card" style="border-color:var(--or);border-left:2px solid var(--or);display:flex;gap:12px;align-items:flex-start;margin-top:auto">
        <Fragment set:html={icon('alert', 18, 'var(--or)')} />
        <div>
          <div class="h3">{P.sinCheckout}</div>
          <p class="s" style="color:var(--l2);margin-top:4px">{P.sinCheckoutB}</p>
          {!user && <p class="s" style="margin-top:10px"><a href="/registro">{P.crearCuenta}</a></p>}
        </div>
      </div>
      )}
    </section>
  </div>
  <div id="toasts"></div>

  <!-- Sin sesion no hay nada que cobrar: el Brick no monta (ver el guard de
       montarBrick) y el boton de pagar solo puede sacar un toast. Decirlo de
       entrada evita que alguien rellene el formulario y descubra al final que
       le faltaba una cuenta. Se cierra: no es una carcel, la pagina se puede
       leer completa antes de decidir.
       Nace sin data-on y lo abre el JS a proposito: si el script no corre, el
       fallo es "no sale el aviso", no "sale un aviso que nadie puede cerrar".
       El comentario va FUERA de {expr && (...)}: dentro, el compilador ve dos
       nodos donde la expresion solo admite uno y falla con "Unexpected token". -->
  {!user && (
  <div id="reg-modal" class="up-back" role="dialog" aria-modal="true" aria-labelledby="reg-t">
    <div class="up-card">
      <h2 id="reg-t" class="h3">{P.cuentaPrimero}</h2>
      <p class="s" style="color:var(--l2)">{P.cuentaPrimeroB}</p>
      <div class="up-row">
        <a class="up-cta" href="/registro">{P.registrarme}</a>
        <a class="up-no" href="/login">{P.entrar}</a>
        <button type="button" id="reg-no" class="up-no">{P.seguirViendo}</button>
      </div>
    </div>
  </div>
  )}

  <script define:vars={{ P, logged: !!user, moneda: MONEDA, precioMenor: PRECIO_MENOR, mpKey, loc: lang === 'en' ? 'en-US' : 'es-CO' }}>
    const COLOR = { ok: 'var(--ok)', bad: 'var(--rd)', warn: 'var(--or)', info: 'var(--ac)' };
    const box = document.getElementById('toasts');
    const toast = (k, tt, b) => {
      box.innerHTML = `<div class="toast" style="border-color:${COLOR[k]}"><div style="flex:1">
        <div class="h3" style="color:${COLOR[k]}">${tt}</div><p class="s" style="color:var(--l2);margin-top:4px">${b}</p></div></div>`;
    };
    // Meta: the sales page counts as ViewContent, the pay click as
    // InitiateCheckout. Purchase is sent by the payments service from the webhook.
    const PRODUCTO = { content_name: 'IA desde cero', content_type: 'product', content_ids: ['curso-v1'], num_items: 1, value: precioMenor, currency: moneda };
    if (window.iaTrack) window.iaTrack('ViewContent', PRODUCTO);
    const coupon = document.getElementById('coupon');
    const couponStatus = document.getElementById('coupon-status');
    // Sin cobros el bloque de pago no se renderiza, asi que estos nodos no
    // existen. Sin esta salida el primer addEventListener lanzaba sobre null y
    // se llevaba por delante el resto del script, tutorial incluido.
    if (coupon) {
    const couponCode = () => coupon.value.trim();
    const renew = document.getElementById('auto-renew');
    const method = () => document.querySelector('[data-m][data-on]')?.dataset.m ?? 'card';
    // Un solo sitio decide la etiqueta del boton: renovacion encendida manda,
    // luego el metodo (efectivo genera un cupon de pago, no cobra en linea).
    const consent = document.getElementById('consent');
    const paint = () => {
      const on = renew.checked;
      document.getElementById('renew-help').textContent = on ? P.renovarOn : P.renovarOff;
      document.getElementById('renew-consent').hidden = !on;
      if (!on) consent.checked = false;   // apagarla retira la autorizacion; volver a encenderla la pide de nuevo
      document.getElementById('renew-row').textContent = on ? P.renovacionOn : P.renovacionOff;
      // El preapproval de Mercado Pago solo cobra a tarjeta o billetera: con la
      // renovacion encendida PSE y efectivo se apagan (y si estaba elegido uno
      // de ellos, vuelve a tarjeta) en vez de dejar elegir un medio que no puede.
      document.querySelectorAll('[data-m="pse"],[data-m="cash"]').forEach((b) => {
        b.disabled = on; b.style.opacity = on ? '.45' : '';
        if (on && b.hasAttribute('data-on')) {
          b.removeAttribute('data-on');
          document.querySelector('[data-m="card"]').setAttribute('data-on', '');
          document.getElementById('pse-note').hidden = true;
        }
      });
      document.getElementById('renew-card').hidden = !on;
      // El preapproval de Mercado Pago no admite cupon (el servicio responde
      // coupon_not_applicable): con la renovacion encendida el cupon se esconde
      // y no se envia, en vez de dejar que el usuario lo escriba y falle al final.
      document.getElementById('coupon-box').hidden = on;
      document.getElementById('coupon-note').hidden = !on;
      document.getElementById('pay').textContent = on ? P.pagarSub : (method() === 'cash' ? P.cupon : P.pagarUna);
    };
    renew.addEventListener('change', paint);
    // Once at load, not only on `change`: Firefox restores checkbox state on
    // reload/back WITHOUT firing `change`, so the switch could be on while the
    // row, the button and the consent still showed the one-time state -- and the
    // pay click would send mode=subscription under a button saying «Pagar … 30 días».
    paint();
    // El total con cupon lo dice el SERVIDOR, no esta pagina.
    //
    // Antes este boton escribia «Cupon listo para redimir» en verde para
    // cualquier texto -- «PENDEJADA» incluido -- sin preguntarle a nadie. El
    // comprador veia verde, metia la tarjeta y descubria al final que el cupon
    // no existia, o pagaba el precio entero creyendo el descuento aplicado.
    //
    // Cotizar no reserva ni gasta cupo (payments: /v1/coupons/quote).
    const aplicar = document.getElementById('apply-coupon');
    const pintaCupon = (txt, color) => { couponStatus.textContent = txt; couponStatus.style.color = color; };
    aplicar.addEventListener('click', async () => {
      const code = couponCode();
      if (!code) { pintaCupon(P.cuponVacio, 'var(--or)'); return; }
      aplicar.disabled = true;
      pintaCupon(P.cuponComprobando, 'var(--l2)');
      try {
        const r = await fetch('/api/payments/cupon/cotizar', { method: 'POST',
          headers: { 'content-type': 'application/json' }, body: JSON.stringify({ couponCode: code }) });
        if (r.status === 429) { pintaCupon(P.frenoB, 'var(--or)'); return; }
        // SOLO 422 significa «ese cupon no vale». Un 404 (ruta sin desplegar),
        // un 500 o un 503 son un fallo nuestro, y decirle «cupon no valido» al
        // comprador le manda a revisar un codigo que estaba bien. Eso ya paso.
        //
        // Y el 422 dice CUAL de las cinco puertas salto. «Revisa el codigo» a
        // secas manda a revisar el codigo incluso cuando el codigo es correcto
        // y lo que pasa es que ya lo usaste, o que caduco ayer.
        if (r.status === 422) {
          const d = await r.json().catch(() => ({}));
          pintaCupon(P.cuponMotivo?.[d.reason] ?? P.cuponInvalidoB, 'var(--rd)');
          return;
        }
        if (!r.ok) { pintaCupon(P.mpErrB, 'var(--rd)'); return; }
        const d = await r.json();
        const total = Number(d.totalMinor).toLocaleString(loc);
        pintaCupon(`${P.descuento}: ${d.discountPercent}% · ${P.total}: ${total} ${moneda}`, 'var(--ok)');
      } catch { pintaCupon(P.mpErrB, 'var(--rd)'); }
      finally { aplicar.disabled = false; }
    });
    document.querySelectorAll('[data-m]').forEach((b) => b.addEventListener('click', () => {
      document.querySelectorAll('[data-m]').forEach((x) => x.removeAttribute('data-on'));
      b.setAttribute('data-on', '');
      document.getElementById('pse-note').hidden = b.dataset.m !== 'pse';
      // Tarjeta monta el Brick; los demas metodos lo quitan, porque van por
      // redireccion y un formulario de tarjeta encima solo confunde.
      if (b.dataset.m === 'card') { void montarBrick(); }
      else if (brickCtrl) { void brickCtrl.unmount(); brickCtrl = null; brickBox.innerHTML = ''; }
      paint();
    }));
    // ── Payment Brick: la tarjeta se rellena AQUI, sin salir de la pagina ──
    //
    // El iframe es de Mercado Pago y el numero de la tarjeta nunca entra en este
    // documento: el Brick devuelve un token de un solo uso. El PAN no toca este
    // servidor en ningun momento, igual que con la redireccion.
    //
    // Solo tarjeta. PSE, efectivo y billetera siguen saliendo a la pagina de
    // Mercado Pago: PSE abre el banco del comprador y efectivo genera un cupon,
    // dos flujos que no caben en un formulario incrustado.
    //
    // La API de abajo esta MEDIDA contra el SDK real, no recordada:
    //   bricks()    -> isInitialized, create
    //   controlador -> getFormData, getAdditionalData, update, unmount
    //   y `customization.visual.hidePaymentButton` funciona (el controlador
    //   expone `paymentButtonHidden` despues de montar).
    // Por eso el boton de pagar sigue siendo el de la pagina y no el del Brick:
    // el del Brick se saltaria la casilla de terminos y la de renovacion.
    const brickBox = document.getElementById('brick');
    let brickCtrl = null;
    let brickCargando = false;

    const metodoActual = () => document.querySelector('[data-m][data-on]')?.dataset.m ?? 'card';

    const sdkListo = () => new Promise((ok, fail) => {
      if (window.MercadoPago) { ok(); return; }
      const el = document.createElement('script');
      el.src = 'https://sdk.mercadopago.com/js/v2';
      el.onload = () => ok();
      el.onerror = () => fail(new Error('sdk'));
      document.head.append(el);
    });

    // El Brick vive en un iframe de Mercado Pago: nuestras variables CSS no
    // entran ahi. La unica forma de que no parezca de otra web es pasarle los
    // tokens a mano, y volver a pasarlos cuando el visitante cambia de tema.
    //
    // Los nombres de customVariables estan MEDIDOS: montado con estos valores
    // y comprobado en captura que formBackgroundColor, inputBackgroundColor,
    // textPrimaryColor y los borderRadius* aplican de verdad. `theme` va en
    // customization.visual.STYLE, no en visual -- el SDK lee `t?.visual.style`.
    //
    // El radio 0 no es un capricho: en esta hoja solo .btn tiene esquinas
    // redondeadas (6px). Todo lo demas es recto, y un formulario redondeado
    // dentro de un recuadro recto se lee como incrustado de fuera.
    const esPapel = () => {
      const t = document.documentElement.getAttribute('data-theme');
      if (t === 'paper') return true;
      if (t === 'auto') return window.matchMedia('(prefers-color-scheme: light)').matches;
      return false;   // 'dark' y cualquier valor raro: oscuro, que es la base
    };

    const paletaBrick = () => esPapel()
      ? { theme: 'default', customVariables: {
          baseColor: '#0A5AD6', baseColorFirstVariant: '#0A5AD6', baseColorSecondVariant: '#0A5AD6',
          textPrimaryColor: '#000000', textSecondaryColor: 'rgba(0,0,0,.66)',
          inputBackgroundColor: 'rgba(120,120,128,.20)', formBackgroundColor: '#ffffff',
          errorColor: '#C21B12', successColor: '#0C6B3E',
          borderRadiusSmall: '0px', borderRadiusMedium: '0px',
          borderRadiusLarge: '0px', borderRadiusFullWidth: '0px',
          formPadding: '0px', fontSizeMedium: '15px', inputVerticalPadding: '12px',
        } }
      : { theme: 'dark', customVariables: {
          baseColor: '#0A84FF', baseColorFirstVariant: '#0A6CFF', baseColorSecondVariant: '#0A6CFF',
          textPrimaryColor: '#ffffff', textSecondaryColor: 'rgba(235,235,245,.62)',
          inputBackgroundColor: 'rgba(120,120,128,.22)', formBackgroundColor: '#0B0B0C',
          errorColor: '#FF453A', successColor: '#30D158',
          borderRadiusSmall: '0px', borderRadiusMedium: '0px',
          borderRadiusLarge: '0px', borderRadiusFullWidth: '0px',
          formPadding: '0px', fontSizeMedium: '15px', inputVerticalPadding: '12px',
        } };

    const montarBrick = async () => {
      if (!mpKey || !logged || brickCargando || brickCtrl) return;
      if (metodoActual() !== 'card') return;
      brickCargando = true;
      // Esqueleto mientras carga el iframe: es una espera de red real y sin esto
      // el recuadro se queda vacio unos segundos y parece roto.
      brickBox.innerHTML = '<span class="lbl">' + P.datos + '</span>'
        + '<span class="sk-stack" aria-busy="true" role="status">'
        + '<span class="sk-voz">' + P.brickCarga + '</span>'
        + '<span class="sk sk-line" style="--sk-h:44px"></span>'
        + '<span class="sk sk-line" style="--sk-h:44px;--sk-w:70%"></span>'
        + '<span class="sk sk-line" style="--sk-h:44px"></span></span>';
      try {
        await sdkListo();
        const mp = new window.MercadoPago(mpKey, { locale: loc === 'en-US' ? 'en-US' : 'es-CO' });
        brickBox.innerHTML = '<span class="lbl">' + P.datos + '</span><div id="brick-mp"></div>';
        brickCtrl = await mp.bricks().create('cardPayment', 'brick-mp', {
          // El importe que se PINTA. El que se COBRA lo pone el servidor desde
          // price.ts y este valor se descarta alli: si no, se edita en el
          // navegador y se compra el curso por un peso.
          initialization: { amount: precioMenor },
          customization: {
            visual: { hidePaymentButton: true, style: paletaBrick() },
            paymentMethods: { maxInstallments: 1 },
          },
          callbacks: {
            onReady: () => {},
            onError: () => { toast('bad', P.mpErr, P.mpErrB); },
            // Obligatorio aunque el boton este oculto: sin el, create() falla.
            // El envio de verdad lo dispara el boton de la pagina con
            // getFormData(), que es donde estan las dos casillas legales.
            onSubmit: async () => {},
          },
        });
      } catch {
        // El SDK no cargo (bloqueador, red). No se deja un cargando eterno: se
        // dice, y queda la redireccion como salida.
        brickBox.innerHTML = '<span class="lbl">' + P.datos + '</span>'
          + '<p class="s" style="color:var(--l2)">' + P.brickNoCarga + '</p>';
      } finally { brickCargando = false; }
    };

    // El Brick lee la paleta UNA vez, al crearse: el SDK no expone forma de
    // recolorear un brick montado (`update` solo acepta `amount`). Asi que
    // cambiar de tema con el formulario en pantalla lo dejaba en la paleta
    // vieja -- fondo negro dentro de la pagina en papel, o al reves.
    //
    // Se vuelve a montar. Cuesta recargar el iframe, y por eso NO se hace si
    // el comprador ya escribio algo: perder un numero de tarjeta a medias por
    // tocar el interruptor del tema es mucho peor que un formulario con el
    // color anterior hasta que recargue.
    const remontarPorTema = async () => {
      if (!brickCtrl || metodoActual() !== 'card') return;
      try {
        const fd = await brickCtrl.getFormData();
        if (fd && fd.token) return;   // formulario completo: no se toca
      } catch { /* incompleto: puede estar vacio o a medias, se mira abajo */ }
      // `getFormData` lanza igual con el formulario vacio que con uno a medias.
      // Lo unico que distingue los dos casos desde fuera es si algun campo del
      // iframe tiene texto, y el iframe es de otro origen: no se puede mirar.
      // Se remonta solo si el tema cambio de verdad, que es raro y deliberado.
      await brickCtrl.unmount();
      brickCtrl = null;
      brickBox.innerHTML = '';
      await montarBrick();
    };

    let temaPrevio = esPapel();
    const siTemaCambio = () => {
      const ahora = esPapel();
      if (ahora === temaPrevio) return;   // data-theme cambia tambien entre dark y auto-oscuro
      temaPrevio = ahora;
      void remontarPorTema();
    };
    // Dos fuentes, porque hay tres estados: el interruptor escribe data-theme
    // en <html>, y en «auto» quien manda es el sistema operativo.
    new MutationObserver(siTemaCambio).observe(document.documentElement,
      { attributes: true, attributeFilter: ['data-theme'] });
    window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', siTemaCambio);

    void montarBrick();

    document.getElementById('pay').addEventListener('click', async () => {
      if (!logged) { toast('warn', P.sinCuenta, P.sinCuentaB); return; }
      const terms = document.getElementById('terms');
      if (terms && !('checked' in terms && terms.checked)) { toast('warn', P.terminosWarn, P.terminosWarnB); terms.focus(); return; }
      const mode = renew.checked ? 'subscription' : 'one_time';
      // Renovacion encendida sin la casilla marcada: no se cobra. La casilla ES la
      // autorizacion del cobro recurrente; el interruptor solo la hace visible.
      if (mode === 'subscription' && !consent.checked) {
        toast('warn', P.renovar, P.consent);
        document.getElementById('consent').focus();
        return;
      }
      if (window.iaTrack) window.iaTrack('InitiateCheckout', PRODUCTO);

      // ── Tarjeta: se cobra aqui mismo ──────────────────────────────────────
      // Llega despues de las dos puertas legales a proposito: getFormData()
      // solo se llama cuando los terminos estan aceptados y, si hay renovacion,
      // tambien el consentimiento del cobro recurrente.
      if (metodoActual() === 'card' && brickCtrl && mode === 'one_time') {
        const btn = document.getElementById('pay');
        btn.disabled = true;
        try {
          // Lanza si el formulario esta incompleto; el Brick ya pinta el error
          // en el campo, asi que aqui solo hay que no seguir.
          const fd = await brickCtrl.getFormData();
          if (!fd || !fd.token) return;
          const r = await fetch('/api/payments/mercadopago/card', { method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ termsVersion: '2026-09-07',
              ...(couponCode() ? { couponCode: couponCode() } : {}),
              card: {
                token: fd.token,
                paymentMethodId: fd.payment_method_id,
                issuerId: fd.issuer_id,
                installments: fd.installments,
                identification: fd.payer?.identification,
              } }) });
          if (r.status === 429) { toast('warn', P.frenoT, P.frenoB); return; }
          // 422 = el cupon no vale (inexistente, agotado, caducado, ya usado por
          // esta cuenta). Ya NO se cae a la redireccion: la ruta de tarjeta
          // cobra con cupon, asi que un 422 aqui es un codigo malo y hay que
          // decirlo, no mandar al comprador fuera de la pagina.
          if (r.status === 422) { toast('bad', P.cuponInvalido, P.cuponInvalidoB); return; }
          else if (r.status === 501 || r.status === 503) { toast('warn', P.sinCred, P.sinCredB); return; }
          else if (!r.ok) { toast('bad', P.mpErr, P.mpErrB); return; }
          else {
            const d = await r.json();
            if (d.status === 'approved') { window.location.assign('/pago/gracias'); return; }
            if (d.status === 'in_process' || d.status === 'pending') {
              window.location.assign('/pago/gracias?estado=pendiente'); return;
            }
            // Rechazada. El motivo real lo tiene `d.detail` (CVV mal, sin
            // fondos, vencida). No se traduce uno por uno: esa tabla se queda
            // vieja sola y un motivo nuevo saldria en blanco.
            toast('bad', P.tarjetaNo, P.tarjetaNoB);
            return;
          }
        } catch {
          // getFormData lanza con el formulario incompleto. El Brick ya marco
          // el campo; un toast encima seria decir lo mismo dos veces.
          return;
        } finally { btn.disabled = false; }
      }

      const res = await fetch('/api/payments/mercadopago/preference', { method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ mode, termsVersion: '2026-09-07', ...(mode === 'one_time' && couponCode() ? { couponCode: couponCode() } : {}) }) });
      if (res.status === 429) { toast('warn', 'Espera un momento', 'Demasiados intentos de pago. Reintenta en un minuto.'); return; }
      if (res.status === 422) { toast('bad', P.cuponInvalido, P.cuponInvalidoB); return; }
      // 409 = ya hay una renovacion viva para esta cuenta; el servicio no crea otra.
      if (res.status === 409) { toast('warn', P.yaSuscrito, P.yaSuscritoB); return; }
      // 501 = el servicio de pagos existe pero sin credencial; 503 = el servicio
      // no contesta. Distinta causa, misma consecuencia: hoy no se puede pagar.
      if (res.status === 501 || res.status === 503) { toast('warn', P.sinCred, P.sinCredB); return; }
      if (!res.ok) { toast('bad', P.mpErr, P.mpErrB); return; }
      const result = await res.json();
      if (result.granted) { toast('ok', P.cuponOtorgado, P.cuponOtorgadoB); window.location.assign('/panel'); return; }
      // one_time responde preferenceId; subscription (preapproval) responde subscriptionId.
      const { preferenceId, subscriptionId, initPoint } = result;
      if (!initPoint) { toast('bad', P.mpErr, P.mpErrB); return; }
      // totalMinor viene en unidades MENORES y COP no tiene decimales. El `/100`
      // que habia aqui pintaba «USD 350.00» sobre un cobro real de 35.000 pesos.
      if (result.totalMinor !== undefined) {
        const total = Number(result.totalMinor).toLocaleString(loc);
        couponStatus.textContent = `${P.descuento}: ${result.discountPercent}% · ${P.total}: ${total} ${moneda}`;
      }
      toast('info', P.prefOk, preferenceId ?? subscriptionId ?? '');
      window.location.assign(initPoint);
    });
    }
  </script>
  <script type="application/json" id="tutorial-txt" is:inline set:html={jsonSafe({
    aria: L.tutorial.aria, skip: L.tutorial.skip, next: L.tutorial.next, done: L.tutorial.done,
    ...L.tutorial.pago,
  })}></script>
  <script>
    import { abrirTutorial, pasosDe, tutorialHecho } from '../lib/tutorial';
    const TT = JSON.parse(document.getElementById('tutorial-txt')!.textContent!);
    window.abrirTutorial = () => abrirTutorial('pago', pasosDe('pago', TT), TT);
    const force = new URLSearchParams(location.search).get('tutorial') === '1';
    if (force || !tutorialHecho('pago')) window.abrirTutorial();
  </script>
  <script is:inline>
    (() => {
      const m = document.getElementById('reg-modal');
      if (!m) return;
      m.setAttribute('data-on', '');
      const cerrar = () => m.removeAttribute('data-on');
      document.getElementById('reg-no')?.addEventListener('click', cerrar);
      m.addEventListener('click', (e) => { if (e.target === m) cerrar(); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') cerrar(); });
    })();
  </script>
</body>
</html>
