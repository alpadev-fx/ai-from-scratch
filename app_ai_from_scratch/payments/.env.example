NODE_ENV=development
HOST=127.0.0.1
PORT=8785
DATABASE_URL=
PAYMENTS_SECRET=
ENTITLEMENTS_SECRET=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_PUBLIC_KEY=
PUBLIC_ORIGIN=http://localhost:4321
ENTITLEMENTS_URL=http://localhost:8787/api/internal/entitlements
WEBHOOK_WINDOW_SECONDS=300
# Meta Conversions API (ads measurement). Both or neither; the service refuses to boot with one.
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# ---------------------------------------------------------------------------
# The live-token escape hatch. payments/src/config.ts:79 refuses an APP_USR-
# token outside production unless this is exactly "1". Setting it means real
# cards get charged from a non-production deploy, so it exists for one-off
# verification against the real gateway and nothing else. Leave it unset.
# MP_ALLOW_LIVE_OUTSIDE_PRODUCTION=

# The origin Mercado Pago must call back on, when it differs from PUBLIC_ORIGIN
# (behind a tunnel or a separate payments hostname). Defaults to PUBLIC_ORIGIN.
# WEBHOOK_PUBLIC_ORIGIN=

# Fastify log level. Default info.
# LOG_LEVEL=
