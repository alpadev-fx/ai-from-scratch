---
// Un tutorial y su hilo de comentarios.
//
// Mismo muro que el índice y por el mismo motivo: quien no ha pagado no recibe
// el cuerpo, recibe un redirect a la vitrina. Un 404 aquí sería mentira (el
// tutorial existe) y renderizarlo oculto sería regalarlo.
export const prerender = false;
import App from '../../layouts/App.astro';
import { gate } from '../../lib/session';
import { t, resolveLang } from '../../lib/i18n';
import { icon } from '../../lib/icons';
import HiloComentarios from '../../components/HiloComentarios.astro';
import { tutorialPorSlug, enIdioma } from '../../data/tutoriales-mock';

const { user, redirect } = await gate(Astro.request);
if (redirect) return Astro.redirect(redirect);

const lang = resolveLang(user!.lang, Astro.request);
const L = t(lang);
const T = L.tutoriales;
const C = L.curso;

// El muro antes que la búsqueda: así un slug inexistente y uno de pago llevan
// al mismo sitio y la página no filtra qué tutoriales existen.
if (user!.role === 'student' && user!.paid !== true) return Astro.redirect('/tutoriales');

const crudo = tutorialPorSlug(String(Astro.params.slug ?? ''));
if (!crudo) return Astro.redirect('/tutoriales');
const x = enIdioma(crudo, lang);

const NIVEL: Record<string, string> = { facil: C.nFacil, medio: C.nMedio, dificil: C.nDuro };
const COLOR: Record<string, string> = { facil: 'var(--ok)', medio: 'var(--or)', dificil: 'var(--rd)' };
const MAX_MB = 5;
---
<App user={user!} title={x.titulo} crumb={`${T.crumb} / ${x.etiqueta.toUpperCase()}`} active={L.nav.tutoriales}>
  <a slot="topbar" class="btn ghost" style="height:36px;font-size:10px;text-decoration:none" href="/tutoriales">{T.volver}</a>

  <div class="app-pad" style="display:flex;flex-direction:column;gap:26px;max-width:780px">
    <div style="display:flex;flex-direction:column;gap:12px;border-bottom:1px solid var(--hair);padding-bottom:22px">
      <p class="eb">{x.etiqueta}</p>
      <h1 class="h1" style="font-size:clamp(26px,5vw,34px)">{x.titulo}</h1>
      <p class="p" style="max-width:620px">{x.resumen}</p>
      <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
        <span class="s" style={`color:${COLOR[x.nivel] ?? 'var(--l3)'}`}>{NIVEL[x.nivel] ?? x.nivel}</span>
        <span class="s" style="color:var(--l3)">{x.min} {T.min} {T.lectura}</span>
      </div>
    </div>

    <div class="card" style="border-color:var(--hair);border-left:2px solid var(--or);display:flex;gap:12px;align-items:flex-start">
      <Fragment set:html={icon('info', 18, 'var(--or)')} />
      <div>
        <p class="eb">{T.mockEb}</p>
        <div class="h3" style="margin-top:2px">{T.mockTitulo}</div>
        <p class="s" style="color:var(--l2);margin-top:4px">{T.mockB}</p>
      </div>
    </div>

    <div style="display:flex;flex-direction:column;gap:14px;min-width:0">
      {x.cuerpo.map((parrafo) => <p class="p" style="min-width:0">{parrafo}</p>)}
    </div>

    <HiloComentarios comentarios={x.comentarios} yo={user!.name} txt={T} maxMb={MAX_MB} />
  </div>
</App>
