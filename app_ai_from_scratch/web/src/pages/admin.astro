---
export const prerender = false;
import App from '../layouts/App.astro';
import { gate, apiFetch, apiTry } from '../lib/session';
import { t, resolveLang } from '../lib/i18n';
import { icon } from '../lib/icons';
import { MONEDA } from '../lib/price';
const { user, redirect } = await gate(Astro.request, ['admin']);
if (redirect) return Astro.redirect(redirect);
type U = { id: number; email: string; name: string; role: string; paid: number; cohort: string | null; created_at: string };
type P = { id: number; status: string; amount: number; currency: string; at: string; ext_id: string };
const users = (await apiFetch<{ users: U[] }>('/api/admin/users', Astro.request))?.users ?? [];
// apiFetch lanza con cualquier codigo que no sea 2xx, asi que el `?? []` que
// habia aqui no se alcanzaba nunca: con el servicio de pagos apagado la pagina
// entera devolvia 500 y la administracion se quedaba a oscuras por una caja de
// cobros. Los cobros son UNA seccion de /admin, no su condicion de arranque.
const payRes = await apiTry<{ payments: P[] }>('/api/admin/payments', Astro.request);
const pays = payRes.data?.payments ?? [];
const paysOk = payRes.status === 200;
type C = { id: number; code: string; percent: number; maxRedemptions: number | null;
  active: boolean; used: number; holding: number; startsAt: string | null; endsAt: string | null;
  discountMinor: number; totalMinor: number };
// apiTry y no apiFetch, por lo mismo que los cobros: los cupones son UNA caja
// de /admin y el servicio de pagos caido no puede apagar la administracion.
const cupRes = await apiTry<{ coupons: C[]; priceMinor: number }>('/api/admin/cupones', Astro.request);
const cupones = cupRes.data?.coupons ?? [];
const cuponesOk = cupRes.status === 200;
const estadoCupon = (c: C) => !c.active ? 'revocado'
  : c.endsAt && new Date(c.endsAt) <= new Date() ? 'caducado'
  : c.maxRedemptions !== null && c.used >= c.maxRedemptions ? 'agotado' : 'activo';
const COLC: Record<string, string> = { activo: 'var(--ok)', revocado: 'var(--l3)',
  caducado: 'var(--l3)', agotado: 'var(--or)' };
const L = t(resolveLang(user!.lang, Astro.request));
const rootLabsLabel = resolveLang(user!.lang, Astro.request) === 'en' ? 'Solved labs' : 'Labs resueltos';
const ROLEC: Record<string, string> = { student: 'var(--l2)', tutor: 'var(--ac)', admin: 'var(--or)', root: 'var(--rd)' };
const ROLE_ES: Record<string, string> = { student: 'Estudiante', tutor: 'Tutor', admin: 'Admin', root: 'Root' };
// Cobrado, AGRUPADO POR MONEDA. Antes esto era un `reduce` sobre `p.amount` con
// «USD» escrito encima, y la tabla de cobros guarda la moneda por fila: los
// cobros viejos son USD y los nuevos COP, asi que aquel numero sumaba 9.99
// dolares con 35.000 pesos y presentaba el resultado como dolares. Un total que
// mezcla monedas no es un total.
const porMoneda = new Map<string, number>();
for (const p of pays) {
  if (p.status !== 'approved') continue;
  porMoneda.set(p.currency, (porMoneda.get(p.currency) ?? 0) + p.amount);
}
// COP no tiene decimales y USD si, asi que el formato lo decide la moneda de la
// fila y no un `toFixed(2)` global.
const DEC: Record<string, number> = { COP: 0, CLP: 0, JPY: 0 };
const cobrado = [...porMoneda.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([mon, tot]) => {
    const d = DEC[mon] ?? 2;
    return `${tot.toLocaleString('es-CO', { minimumFractionDigits: d, maximumFractionDigits: d })} ${mon}`;
  });
---
<App user={user!} title="Admin" crumb="ADMIN / PLATAFORMA" active="Admin">
  <span slot="topbar" class="lbl" style="color:var(--or)">MODO ADMIN</span>
  {user!.role === 'root' && <a slot="topbar" class="btn ghost" style="text-decoration:none" href="/root/labs-resueltos">{rootLabsLabel}</a>}
  <div style="padding:30px 28px 48px;display:flex;flex-direction:column;gap:26px;max-width:1180px">
    <div style="display:flex;flex-direction:column;gap:12px">
      <p class="eb">Panel · Admin</p>
      <h1 class="h1">Plataforma</h1>
    </div>

    <div style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:22px">
      <div class="card" style="display:flex;flex-direction:column;gap:10px"><p class="lbl">Cuentas activas</p><div class="num" style="font:700 34px/1 var(--f);letter-spacing:-.04em">{users.length}</div><p class="s">las cuentas eliminadas no cuentan</p></div>
      <div class="card" style="display:flex;flex-direction:column;gap:10px"><p class="lbl">Tutores</p><div class="num" style="font:700 34px/1 var(--f);letter-spacing:-.04em">{users.filter((u) => u.role === 'tutor').length}</div><p class="s">de {users.length} cuentas</p></div>
      <div class="card" style="display:flex;flex-direction:column;gap:10px"><p class="lbl">Cobrado</p><div class="num" style={`font:700 34px/1 var(--f);letter-spacing:-.04em;color:${paysOk ? 'var(--ok)' : 'var(--l3)'}`}>{paysOk ? (cobrado[0] ?? `0 ${MONEDA}`) : '—'}</div><p class="s">{paysOk ? `${pays.filter((p) => p.status === 'approved').length} pagos aprobados${cobrado.length > 1 ? ` · y ${cobrado.slice(1).join(' · ')}` : ''}` : 'cobros sin responder'}</p></div>
      <div class="card" style="display:flex;flex-direction:column;gap:10px"><p class="lbl">Pendientes</p><div class="num" style={`font:700 34px/1 var(--f);letter-spacing:-.04em;color:${paysOk ? 'var(--or)' : 'var(--l3)'}`}>{paysOk ? pays.filter((p) => p.status === 'pending').length : '—'}</div><p class="s">{paysOk ? 'suscripciones por cobrar' : 'cobros sin responder'}</p></div>
    </div>

    <div style="display:flex;flex-direction:column;gap:14px">
      <p class="lbl">Usuarios y roles</p>
      <!-- .tblwrap: nombre, correo, rol, alta y compra no caben en 362 px y
           apilarlos vuelve la tabla ilegible. Scroll horizontal DENTRO de su
           contenedor, que es el trato correcto para una tabla densa, y asi el
           body nunca desborda. -->
      <div class="tblwrap"><div style="display:flex;flex-direction:column;gap:14px">
        <div class="tbl-admin" style="grid-template-columns:minmax(0,1.2fr) minmax(0,1.6fr) 150px 110px 90px 110px;padding-bottom:10px;border-bottom:1px solid var(--hair)">
          <div class="tblhead">Nombre</div><div class="tblhead">Correo</div><div class="tblhead">Rol</div><div class="tblhead">Alta</div><div class="tblhead">Compra</div><div class="tblhead">Historia</div>
      </div>
      {users.map((u) => (
          <div class="tbl-admin" style="grid-template-columns:minmax(0,1.2fr) minmax(0,1.6fr) 150px 110px 90px 110px;align-items:center;height:56px;border-bottom:1px solid var(--hair2)">
          <span style="font:600 14px/1.2 var(--f)">{u.name}</span>
          <span class="s" style="color:var(--l2)">{u.email}</span>
          <!-- 16px y 44 de alto: el estilo en linea le ganaba a .input{font-size:16px}
               del bloque movil, y por debajo de 16 iOS Safari hace zoom al enfocar.
               34px tambien incumplia el suelo tactil de 44. -->
          {/* La api es la guardia: solo un root da o quita root (403 solo_root).
              Aqui solo se evita ofrecer lo que siempre seria rechazado.

              `root` se incluye tambien cuando la FILA ya es root, aunque quien
              mira no lo sea. Sin esa mitad, la fila del root se quedaria sin
              opcion coincidente y el select pintaria «Estudiante»: una mentira
              en pantalla, y un descuido a un clic de intentar degradarlo. */}
          <select data-role={u.id} class="input" disabled={u.role === 'root' && user!.role !== 'root'}
            style="font:500 16px/1 var(--m);letter-spacing:.06em;padding:0 8px">
            {['student', 'tutor', 'admin', ...(user!.role === 'root' || u.role === 'root' ? ['root'] : [])]
              .map((r) => <option value={r} selected={u.role === r} style={`color:${ROLEC[r]}`}>{ROLE_ES[r]}</option>)}
          </select>
          <span class="num s">{u.created_at.slice(0, 10)}</span>
          <span class="s" style={`color:${u.paid ? 'var(--ok)' : 'var(--l3)'}`}>{u.paid ? 'Sí' : 'No'}</span>
          {u.role === 'student' ? <a class="s" href={`/admin/progreso?student=${u.id}`}>Ver progreso</a> : <span class="s" style="color:var(--l3)">-</span>}
        </div>
      ))}
      </div></div><!-- /.tblwrap: el aviso de abajo NO debe scrollear -->

      <div class="card" style="border-color:var(--hair);border-left:2px solid var(--or);display:flex;gap:12px;align-items:flex-start;margin-top:6px">
        <Fragment set:html={icon('alert', 18, 'var(--or)')} />
        <div><div class="h3">Cambiar un rol se registra</div><p class="s" style="color:var(--l2);margin-top:4px">Queda en el historial con quién lo hizo y cuándo. La plataforma no se puede quedar sin admins: el servidor rechaza ese cambio.</p></div>
      </div>
    </div>

    <div style="display:flex;flex-direction:column;gap:14px">
      <p class="lbl">Cupones</p>
      {!cuponesOk && (
        <div class="card" style="border-left:2px solid var(--or)">
          <div class="h3">Los cobros no responden</div>
          <p class="s" style="color:var(--l2);margin-top:4px">Sin ese servicio no se pueden ni ver ni crear cupones. El resto de la administración sigue funcionando.</p>
        </div>
      )}
      {cuponesOk && (
      <div class="card" style="display:flex;flex-direction:column;gap:14px">
        <div>
          <div class="h3">Crear un cupón</div>
          <p class="s" style="color:var(--l2);margin-top:4px">El tope y los días son obligatorios: un cupón sin límite es una barra libre, y así fue como se regaló el curso una vez. El descuento es un porcentaje sobre el precio; abajo se ve cuánto queda a pagar.</p>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end">
          <label style="display:flex;flex-direction:column;gap:5px"><span class="lbl">Código</span>
            <input id="cup-code" class="input" placeholder="PRUEBA2000" maxlength="64" style="text-transform:uppercase;width:190px"></label>
          <label style="display:flex;flex-direction:column;gap:5px"><span class="lbl">Descuento %</span>
            <input id="cup-pct" class="input" type="number" min="1" max="100" value="95" style="width:110px"></label>
          <label style="display:flex;flex-direction:column;gap:5px"><span class="lbl">Usos máximos</span>
            <input id="cup-max" class="input" type="number" min="1" value="3" style="width:120px"></label>
          <label style="display:flex;flex-direction:column;gap:5px"><span class="lbl">Días</span>
            <input id="cup-dias" class="input" type="number" min="1" value="7" style="width:100px"></label>
          <button id="cup-crear" class="btn" type="button">Crear</button>
        </div>
        <p id="cup-total" class="s" style="color:var(--l2)" data-precio={String(cupRes.data?.priceMinor ?? 0)} data-moneda={MONEDA}></p>
      </div>
      )}
      {cuponesOk && cupones.length > 0 && (
      <div class="tblwrap"><div style="display:flex;flex-direction:column;gap:14px">
        <div class="tbl-admin" style="grid-template-columns:minmax(0,1.2fr) 100px 120px 165px 110px 185px;padding-bottom:10px;border-bottom:1px solid var(--hair)">
          <div class="tblhead">Código</div><div class="tblhead">Descuento</div><div class="tblhead">Queda en</div><div class="tblhead">Usos</div><div class="tblhead">Estado</div><div class="tblhead">Acción</div>
        </div>
        {cupones.map((c) => (
          <div class="tbl-admin" style="grid-template-columns:minmax(0,1.2fr) 100px 120px 165px 110px 185px;align-items:center;height:56px;border-bottom:1px solid var(--hair2)">
            <span class="num" style="font:600 14px/1.2 var(--m)">{c.code}</span>
            <span class="s">{c.percent}%</span>
            <span class="num s">{c.totalMinor.toLocaleString('es-CO')} {MONEDA}</span>
            <span class="s" style="color:var(--l2)">{c.used} de {c.maxRedemptions ?? '∞'}{c.holding > 0 && <span style="color:var(--or)"> · {c.holding} sin pagar</span>}</span>
            <span class="s" style={`color:${COLC[estadoCupon(c)]}`}>{estadoCupon(c)}</span>
            <div style="display:flex;gap:6px">
              <button class="btn ghost" type="button" data-cup={c.code} data-activar={c.active ? '0' : '1'}
                style="height:32px;padding:0 10px">{c.active ? 'Revocar' : 'Activar'}</button>
              {c.holding > 0 && (
                <button class="btn ghost" type="button" data-liberar={c.code}
                  style="height:32px;padding:0 10px;color:var(--or)">Soltar</button>
              )}
            </div>
          </div>
        ))}
      </div></div>
      )}
      {cuponesOk && cupones.length === 0 && (
        <p class="s" style="color:var(--l3)">Todavía no hay cupones.</p>
      )}
      <div class="card" style="border-color:var(--hair);border-left:2px solid var(--or);display:flex;gap:12px;align-items:flex-start">
        <Fragment set:html={icon('alert', 18, 'var(--or)')} />
        <div><div class="h3">Revocar no quita el acceso · «sin pagar» son reservas</div><p class="s" style="color:var(--l2);margin-top:4px">Un cupón se reserva al pulsar «Pagar» y la reserva ocupa un uso durante 30 minutos aunque el pago nunca termine. «Soltar» las libera al instante: no es una compra, así que no se pierde nada. Quien ya redimió el cupón conserva el curso: pagó o se le regaló, y eso no se deshace desde aquí. Revocar solo impide que el código abra más cuentas. Un cupón del 100 % no pasa por Mercado Pago: concede el curso directamente.</p></div>
      </div>
    </div>
  </div>

  <script>
    document.querySelectorAll<HTMLSelectElement>('[data-role]').forEach((sel) => {
      const before = sel.value;
      sel.addEventListener('change', async () => {
        const id = sel.dataset.role!;
        const res = await fetch(`/api/admin/users/${id}/role`, {
          method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ role: sel.value }),
        });
        const d = await res.json().catch(() => ({}));
        if (res.ok) { window.toast('info', 'Rol actualizado', `${d.user.name} ahora es ${d.user.role}. Queda en el historial.`); return; }
        sel.value = before;
        window.toast('bad', 'No se cambió el rol', d.msg ?? 'El servidor lo rechazó.');
      });
    });

    // ── Cupones ────────────────────────────────────────────────────────────
    //
    // El precio vive en price.ts y esta pantalla NO lo reimprime: se lee del
    // total que ya calculo el servidor para el primer cupon de la tabla, o del
    // atributo que deja el frontmatter. Un 39.990 escrito aqui a mano seria la
    // cuarta copia del precio y la que se queda vieja.
    const cCode = document.getElementById('cup-code') as HTMLInputElement | null;
    if (cCode) {
      const cPct = document.getElementById('cup-pct') as HTMLInputElement;
      const cMax = document.getElementById('cup-max') as HTMLInputElement;
      const cDias = document.getElementById('cup-dias') as HTMLInputElement;
      const cBtn = document.getElementById('cup-crear') as HTMLButtonElement;
      const cTotal = document.getElementById('cup-total')!;
      const precio = Number(cTotal.dataset.precio ?? '0');
      const moneda = cTotal.dataset.moneda ?? '';

      // Lo que va a pagar el comprador, con la MISMA cuenta que hace el
      // servidor (floor del porcentaje sobre el precio). Si aqui saliera otro
      // numero, el admin estaria creando un cupon a ciegas.
      const pintaTotal = () => {
        const pct = Number(cPct.value);
        if (!Number.isInteger(pct) || pct < 1 || pct > 100 || !precio) { cTotal.textContent = ''; return; }
        const desc = Math.floor(precio * pct / 100);
        cTotal.textContent = pct === 100
          ? 'Al 100 % el cupón no pasa por Mercado Pago: concede el curso directamente.'
          : `Con ${pct}% el comprador pagaría ${(precio - desc).toLocaleString('es-CO')} ${moneda}.`;
      };
      cPct.addEventListener('input', pintaTotal);
      pintaTotal();

      // Cada codigo de error del servicio tiene su frase. Un «no se pudo»
      // generico deja al admin adivinando cual de las cuatro guardas salto.
      const MOTIVO: Record<string, string> = {
        invalid_code: 'El código está vacío o pasa de 64 caracteres.',
        invalid_percent: 'El descuento tiene que ser un entero entre 1 y 100.',
        max_required: 'Falta el tope de usos. No hay valor por defecto a propósito.',
        days_required: 'Faltan los días de validez.',
        free_coupon_cap: 'Un cupón del 100 % no admite un tope tan alto: sería acceso gratis sin control.',
        coupon_exists: 'Ese código ya existe. Revócalo o usa otro.',
      };

      cBtn.addEventListener('click', async () => {
        cBtn.disabled = true;
        try {
          const res = await fetch('/api/admin/cupones', { method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ code: cCode.value, percent: Number(cPct.value),
              max: Number(cMax.value), days: Number(cDias.value) }) });
          const d = await res.json().catch(() => ({}));
          if (!res.ok) {
            window.toast('bad', 'No se creó el cupón', MOTIVO[d.error] ?? 'El servidor lo rechazó.');
            return;
          }
          window.toast('ok', `Cupón ${d.code} creado`,
            `${d.percent}% · quedan ${Number(d.totalMinor).toLocaleString('es-CO')} ${moneda} · hasta ${d.maxRedemptions} usos.`);
          location.reload();
        } finally { cBtn.disabled = false; }
      });
    }

    // Soltar las reservas vivas. No es una compra: solo devuelve el cupo que
    // ocupa un checkout que nunca termino.
    document.querySelectorAll<HTMLButtonElement>('[data-liberar]').forEach((b) => {
      b.addEventListener('click', async () => {
        b.disabled = true;
        try {
          const res = await fetch(`/api/admin/cupones/${encodeURIComponent(b.dataset.liberar!)}/liberar`,
            { method: 'POST' });
          const d = await res.json().catch(() => ({}));
          if (!res.ok) { window.toast('bad', 'No se pudo soltar', 'El servidor lo rechazó.'); return; }
          window.toast('ok', 'Reservas liberadas', `${d.released} uso(s) vuelven a estar disponibles.`);
          location.reload();
        } finally { b.disabled = false; }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-cup]').forEach((b) => {
      b.addEventListener('click', async () => {
        const activar = b.dataset.activar === '1';
        b.disabled = true;
        try {
          const res = await fetch(`/api/admin/cupones/${encodeURIComponent(b.dataset.cup!)}/estado`, {
            method: 'POST', headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ active: activar }) });
          if (!res.ok) { window.toast('bad', 'No se pudo cambiar', 'El servidor lo rechazó.'); return; }
          window.toast('info', activar ? 'Cupón activado' : 'Cupón revocado',
            activar ? 'Vuelve a abrir cuentas.' : 'Deja de abrir cuentas. Quien ya lo redimió conserva el curso.');
          location.reload();
        } finally { b.disabled = false; }
      });
    });
  </script>
</App>
